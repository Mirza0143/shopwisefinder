# Keep all values server-side. Never prefix elevated keys/bot tokens with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use ONE server-side key only:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=sb_secret_your_private_key

ADMIN_USERNAME=choose-a-private-username
ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
ADMIN_SESSION_SECRET=PUT_A_RANDOM_SECRET_HERE

# Telegram 2-step admin login (enabled by default)
ADMIN_TELEGRAM_OTP_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_PRIVATE_TELEGRAM_CHAT_ID
# Optional override for Telegram account pairing; on production the app detects the public HTTPS URL automatically.
TELEGRAM_WEBHOOK_URL=

NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=shopwisefinde-21
NEXT_PUBLIC_AMAZON_DOMAIN=www.amazon.in
